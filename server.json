{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.formatho/runtime",
  "description": "Self-hosted MCP server: 26 deterministic dev, security, and EVM tools.",
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "docker.io/formatho/formatho-runtime:0.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "run"
        },
        {
          "type": "positional",
          "value": "-i"
        },
        {
          "type": "positional",
          "value": "--rm"
        },
        {
          "type": "positional",
          "value": "-v"
        },
        {
          "type": "positional",
          "value": "formatho-audit:/data"
        },
        {
          "type": "positional",
          "value": "docker.io/formatho/formatho-runtime:0.3.0"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.formatho.com/mcp"
    }
  ]
}